# Copy this file to .env (which is git-ignored) and fill in real values.
# 複製此檔為 .env(已被 git 忽略)後填入真實值。
# ⚠️ NEVER commit real secrets to this public repo. / 切勿把真實密鑰提交到公開 repo。

# ── Master key (KEK) ──────────────────────────────────────────
# 32 bytes, base64-encoded. Generate / 產生:  openssl rand -base64 32
# If unset on first run, the server generates one and writes a 0600 keyfile
# OUTSIDE the data directory. Losing it = 2FA & storage credentials must be reset.
# 若首次啟動未設定,伺服器會自動產生並寫到資料目錄之外的 0600 keyfile。
APP_MASTER_KEY=

# ── OAuth (optional) ──────────────────────────────────────────
# Register apps with each provider, then fill in. Keep the secrets private.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Runtime ───────────────────────────────────────────────────
# Data directory holds the SQLite DB and thumbnail cache; keep it out of git.
# 資料目錄存放 SQLite 與縮圖快取,請勿納入版本控制。
# DATA_DIR=./data
# HTTP_ADDR=:8080
